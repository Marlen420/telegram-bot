# Токен от @BotFather
BOT_TOKEN=your_telegram_bot_token

# Ссылка на сайт покупки билетов
TICKET_URL=https://example.com/tickets

# PostgreSQL (контейнер db в docker-compose)
POSTGRES_USER=forum_bot
POSTGRES_PASSWORD=forum_bot_secret
POSTGRES_DB=forum_bot
POSTGRES_PORT=5432

# Подключение к БД
# Docker (бот в контейнере): host = db
# Локально (npm run dev): host = localhost
DATABASE_URL=postgresql://forum_bot:forum_bot_secret@localhost:5432/forum_bot

# Папка с локальными видео (по умолчанию ./videos)
VIDEOS_DIR=./videos

# Путь к конфигу с текстами ответов (по умолчанию ./config/content.json)
CONTENT_CONFIG_PATH=./config/content.json

# QR-код для оплаты (файл images/qr-payment.png)
IMAGES_DIR=./images
QR_IMAGE_NAME=qr-payment

# Пересылка чеков и файлов пользователю @pratovv
# @pratovv должен один раз написать боту /start
FORWARD_TO_USERNAME=pratovv
FORWARD_TO_CHAT_ID=

# Веб-страница статистики (внутри контейнера порт 3000, снаружи — 80)
PORT=3000
STATS_PUBLIC_PORT=80
STATS_USER=admin
STATS_PASSWORD=change_me
